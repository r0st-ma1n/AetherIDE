{
  "name": "ide",
  "version": "1.0.0",
  "description": "PrototypeIDE desktop shell and renderer",
  "main": "electron/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --strictPort",
    "dev:electron": "electron .",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron": "^42.2.0",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.0.6"
  }
}
