{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aether-ide/schemas/aether-project",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "components"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version, increment to trigger migrations"
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "x", "y", "width", "height", "properties"],
      "properties": {
        "type": { "type": "string", "enum": ["Knob", "Slider", "Button"] },
        "id": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 1 },
        "height": { "type": "number", "minimum": 1 },
        "properties": { "type": "object" }
      }
    }
  }
}
