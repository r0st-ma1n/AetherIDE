cmake_minimum_required(VERSION 3.22)
project({{className}} VERSION 1.0.0 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

include(CTest)

# Aether framework, pinned to the version this project was created with. It is always
# built from source as part of the project. To build against a local checkout without
# network access (AetherIDE does this), pass
#   -DFETCHCONTENT_SOURCE_DIR_AETHER=<AetherIDE repository root>
set(AETHER_MIN_VERSION {{aetherVersion}})

if (NOT TARGET aether_core)
  include(FetchContent)
  FetchContent_Declare(aether
    GIT_REPOSITORY {{aetherRepository}}
    GIT_TAG v{{aetherVersion}}
    GIT_SHALLOW TRUE
    SOURCE_SUBDIR framework
  )
  FetchContent_MakeAvailable(aether)
endif()

if (NOT TARGET aether_core)
  message(FATAL_ERROR
    "Aether framework not found. FETCHCONTENT_SOURCE_DIR_AETHER must point to the "
    "AetherIDE repository root, not to its framework/ directory.")
endif()
if (AETHER_VERSION VERSION_LESS AETHER_MIN_VERSION)
  message(FATAL_ERROR
    "{{className}} needs Aether ${AETHER_MIN_VERSION} or newer, found ${AETHER_VERSION}.")
endif()

# Plugin module: the processor plus the designer UI class (compiled, unused until the
# plugin window lands).
add_library({{className}} MODULE
    {{className}}Processor.cpp
    {{className}}.cpp
)

target_link_libraries({{className}} PRIVATE aether_core)
target_include_directories({{className}} PRIVATE .)
set_target_properties({{className}} PROPERTIES PREFIX "")

# Smoke tests in the headless host: the plugin loads and processes audio.
if (BUILD_TESTING AND TARGET aether_host)
  add_test(NAME {{className}}_loads
    COMMAND aether_host --plugin $<TARGET_FILE:{{className}}> --list-params)
  add_test(NAME {{className}}_renders
    COMMAND aether_host --plugin $<TARGET_FILE:{{className}}> --sine 440 --duration 0.1
            --out ${CMAKE_CURRENT_BINARY_DIR}/{{className}}_renders.wav)
  set_tests_properties({{className}}_renders PROPERTIES PASS_REGULAR_EXPRESSION "Rendered")
endif()
